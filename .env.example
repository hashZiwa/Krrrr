# Server
PORT=4000
SLEEP_DATA_SOURCE=mock

# Training data and model paths are discovered automatically by default:
# - data/rawdata/train
# - data/rawdata/validation
# - model

# Mobius / oneM2M common platform settings.
# Copy this file to .env and fill real values there. .env is ignored by git.
MOBIUS_BASE_URL=https://onem2m.iotcoss.ac.kr
MOBIUS_AE_PATH=Mobius/ae_YOUR_AE
MOBIUS_X_M2M_RI=123
MOBIUS_X_M2M_ORIGIN=SOrigin_YOUR_ORIGIN
MOBIUS_API_KEY=replace-with-api-key
MOBIUS_AUTH_CUSTOM_CREATOR=replace-with-creator
MOBIUS_AUTH_CUSTOM_LECTURE=replace-with-lecture

# Per-feature status containers used for reading platform data.
# Example: MOBIUS_STATUS_CONTAINER_BREATH_CONDITION -> breathCondition
MOBIUS_STATUS_CONTAINER_BREATH_CONDITION=STATUS_CNT/BREATH_CONDITION_CNT

# Per-feature upload containers.
# Add more entries with the MOBIUS_UPLOAD_CONTAINER_ prefix as needed.
# The suffix becomes the service feature key in camelCase.
# Example: MOBIUS_UPLOAD_CONTAINER_SLEEP_ANALYSIS -> sleepAnalysis
MOBIUS_UPLOAD_CONTAINER_SLEEP_ANALYSIS=ANALYSIS/SLEEP_CN
MOBIUS_UPLOAD_CONTAINER_EVENT_NOTE=ANALYSIS/EVENT_NOTE_CN
